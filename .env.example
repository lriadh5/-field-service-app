# Postgres connection string. Netlify DB sets NETLIFY_DATABASE_URL automatically; either works.
# Leave empty in local development to use the built-in PGlite database in .data/.
DATABASE_URL=

# Comma-separated emails that can open /admin (the platform owner's panel).
PLATFORM_ADMIN_EMAILS=

# Public product name shown across the app.
NEXT_PUBLIC_APP_NAME=Field Service App

# Full site URL used in invite links, e.g. https://app.example.com (optional; defaults to the request host).
APP_URL=
